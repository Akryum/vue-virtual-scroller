{
  "name": "vue-virtual-scroller",
  "type": "module",
  "version": "3.0.5",
  "description": "Smooth scrolling for any amount of data",
  "author": {
    "name": "Guillaume Chau",
    "email": "guillaume.b.chau@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/Akryum/vue-virtual-scroller#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akryum/vue-virtual-scroller.git"
  },
  "bugs": {
    "url": "https://github.com/Akryum/vue-virtual-scroller/issues"
  },
  "keywords": [
    "vue",
    "vuejs",
    "plugin"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-virtual-scroller.js",
      "default": "./dist/vue-virtual-scroller.js"
    },
    "./components/DynamicScroller": "./dist/components/DynamicScroller.js",
    "./components/DynamicScrollerItem": "./dist/components/DynamicScrollerItem.js",
    "./components/RecycleScroller": "./dist/components/RecycleScroller.js",
    "./components/WindowScroller": "./dist/components/WindowScroller.js",
    "./composables/useDynamicScroller": "./dist/composables/useDynamicScroller.js",
    "./composables/useDynamicScrollerItem": "./dist/composables/useDynamicScrollerItem.js",
    "./composables/useIdState": "./dist/composables/useIdState.js",
    "./composables/useRecycleScroller": "./dist/composables/useRecycleScroller.js",
    "./composables/useTableColumnWidths": "./dist/composables/useTableColumnWidths.js",
    "./composables/useWindowScroller": "./dist/composables/useWindowScroller.js",
    "./utils": "./dist/utils.js",
    "./types": {
      "types": "./dist/types.d.ts"
    },
    "./dist/vue-virtual-scroller.css": {
      "style": "./dist/vue-virtual-scroller.css",
      "default": "./dist/vue-virtual-scroller.css"
    },
    "./index.css": {
      "style": "./dist/vue-virtual-scroller.css",
      "default": "./dist/vue-virtual-scroller.css"
    }
  },
  "module": "dist/vue-virtual-scroller.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "vite build && node scripts/post-build.mjs",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "node ./scripts/check-package-exports.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test:package",
    "lint": "cd ../../ && pnpm run lint"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^28.1.0",
    "typescript": "^5.3.3",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "4.0.16",
    "vue": "^3.5.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ],
  "publishConfig": {
    "access": "public"
  }
}
